/* Checked active-source conditional-expression manifest.
 *
 * Define CUPIDC_PP_CONDITIONAL_CASE(expression, if_count, elif_count,
 * expected_i386) before including this file.  The expected result uses the
 * freestanding C11 i386 profile: __STDC_VERSION__=201112L, four-byte
 * pointers, __BYTE_ORDER__=__ORDER_LITTLE_ENDIAN__,
 * OPL_ENABLE_STEREOEXT=0, OPL_QUIRK_CHANNELSAMPLEDELAY=1,
 * __bool_true_false_are_defined=1, ORIGCODE and DOOM_PORT_CUPIDOS undefined,
 * and the host/platform macros undefined.
 */
CUPIDC_PP_CONDITIONAL_CASE("! defined ( CUPIDBUILD_HOST_STREAM_LIMIT )", 1u, 0u, 1)
CUPIDC_PP_CONDITIONAL_CASE("! defined ( CUPID_HOSTED_I386_LINUX_ABI_H )", 3u, 0u, 1)
CUPIDC_PP_CONDITIONAL_CASE("! defined ( CUPID_HOSTED_I386_WINDOWS_H )", 1u, 0u, 1)
CUPIDC_PP_CONDITIONAL_CASE("! defined ( CUPID_RUNTIME_WINDOWS )", 2u, 0u, 1)
CUPIDC_PP_CONDITIONAL_CASE("! defined ( _GNU_SOURCE )", 1u, 0u, 1)
CUPIDC_PP_CONDITIONAL_CASE("! defined ( _POSIX_C_SOURCE )", 1u, 0u, 1)
CUPIDC_PP_CONDITIONAL_CASE("! defined ( _WIN32 )", 19u, 0u, 1)
CUPIDC_PP_CONDITIONAL_CASE("! defined ( _WIN32 ) && ! defined ( __MACOSX__ ) && ! defined ( __DJGPP__ )", 1u, 0u, 1)
CUPIDC_PP_CONDITIONAL_CASE("! defined ( __SIZEOF_POINTER__ ) || __SIZEOF_POINTER__ != 4", 1u, 0u, 0)
CUPIDC_PP_CONDITIONAL_CASE("! defined ( __STDC_VERSION__ ) || ( __STDC_VERSION__ < 202311L )", 1u, 0u, 1)
