CUPIDC_PP_CONDITIONAL_CASE("defined ( ORIGCODE ) || defined ( DOOM_PORT_CUPIDOS )", 2u, 0u, 0)
CUPIDC_PP_CONDITIONAL_CASE("_MSC_VER < 1400", 1u, 0u, 1)
