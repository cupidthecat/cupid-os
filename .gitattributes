# Canonical LF text prevents host checkout policy from changing embedded source.
* text=auto eol=lf

# Preserve the reviewed SIMD source bytes across the ownership rename.
kernel/cpu/simd.cc -text

# Keep binary fixtures and assets byte-for-byte.
*.bin binary
*.bmp binary
*.elf binary
*.iso binary
*.jpeg binary
*.jpg binary
*.pcap binary
*.png binary
*.ttf binary
*.wad binary

# Preserve the official Freedoom release bundle exactly as distributed.
third_party/freedoom/0.13.0/COPYING.txt -text
third_party/freedoom/0.13.0/CREDITS-MUSIC.txt -text
third_party/freedoom/0.13.0/CREDITS.txt -text
third_party/freedoom/0.13.0/README.html -text
third_party/freedoom/0.13.0/freedoom-0.13.0-CHECKSUM -text
third_party/freedoom/0.13.0/freedoom-0.13.0.zip filter=lfs diff=lfs merge=lfs -text
third_party/freedoom/0.13.0/freedoom-0.13.0.zip.sig -text
third_party/freedoom/0.13.0/freedoom1.wad filter=lfs diff=lfs merge=lfs -text
