+#include "cupidbuild_source_path.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#if defined(NATIVE_SOURCE_PATH_WINDOWS)
+#include "path_encoding.h"
+#include <wchar.h>
+#include <io.h>
+#include <fcntl.h>
+#endif
+
+static int invoke(int argc, char **argv) {
+  char output[8192];
+  const char *root, *request;
+  size_t capacity = sizeof(output);
+  int result;
+  if (argc != 4) return 10;
+  root = argv[2]; request = argv[3];
+  (void)memset(output, 0x5a, sizeof(output));
+  if (strcmp(argv[1], "null-root") == 0) root = (const char *)0;
+  else if (strcmp(argv[1], "null-request") == 0) request = (const char *)0;
+  else if (strcmp(argv[1], "zero-capacity") == 0) capacity = 0u;
+  else if (strcmp(argv[1], "short-capacity") == 0) capacity = 2u;
+  else if (strcmp(argv[1], "bad-request") == 0) request = "bad\xc0\xaf";
+  else if (strcmp(argv[1], "bad-root") == 0) root = "bad\xed\xa0\x80";
+  else if (strcmp(argv[1], "null-output") == 0)
+    return cupidbuild_source_path_absolute(root, request, (char *)0, capacity) ? 11 : 2;
+  else if (strcmp(argv[1], "normal") != 0) return 12;
+  result = cupidbuild_source_path_absolute(root, request, output, capacity);
+  if (!result) return capacity && output[0] ? 13 : 2;
+  if (fwrite(output, 1u, strlen(output), stdout) != strlen(output) || fflush(stdout) != 0) return 14;
+  return 0;
+}
+
+#if defined(NATIVE_SOURCE_PATH_WINDOWS)
+int wmain(int argc, wchar_t **wide) {
+  char **argv = (char **)calloc((size_t)argc + 1u, sizeof(char *));
+  int index, result = 126;
+  if (!argv) return result;
+  if (_setmode(_fileno(stdout), _O_BINARY) == -1) goto done;
+  for (index = 0; index < argc; index++) {
+    size_t bytes = 0u;
+    if (!cupidbuild_path_to_utf8((const unsigned short *)wide[index], wcslen(wide[index]),
+                                (char *)0, 0u, &bytes)) goto done;
+    argv[index] = (char *)malloc(bytes + 1u);
+    if (!argv[index] || !cupidbuild_path_to_utf8((const unsigned short *)wide[index], wcslen(wide[index]),
+                                argv[index], bytes + 1u, &bytes)) goto done;
+  }
+  result = invoke(argc, argv);
+done:
+  for (index = 0; index < argc; index++) free(argv[index]);
+  free(argv);
+  return result;
+}
+#else
+int main(int argc, char **argv) { return invoke(argc, argv); }
+#endif
