+#include "cupidbuild_disk_integer.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifndef CUPID_DISK_INTEGER_NATIVE
+#include "fgetc_extension.h"
+#endif
+
+static int read_u32(FILE *input, uint32_t *result_out) {
+  unsigned char bytes[4];
+  if (fread(bytes, 1, sizeof(bytes), input) != sizeof(bytes)) return 0;
+  *result_out = (uint32_t)bytes[0] | ((uint32_t)bytes[1] << 8) |
+                ((uint32_t)bytes[2] << 16) | ((uint32_t)bytes[3] << 24);
+  return 1;
+}
+
+int main(int argc, char **argv) {
+  FILE *input;
+  FILE *output;
+  uint32_t count;
+  uint32_t index;
+  if (argc != 4) return 20;
+  input = fopen(argv[1], "rb");
+  if (!input || !read_u32(input, &count)) return 21;
+  output = fopen(argv[2], "wb");
+  if (!output) return 30;
+  for (index = 0; index < count; index++) {
+    uint32_t profile;
+    uint32_t digit_limit;
+    uint32_t size;
+    unsigned char *text;
+    cupidbuild_disk_integer_t result;
+    cupidbuild_disk_integer_status_t status;
+    if (!read_u32(input, &profile) || !read_u32(input, &digit_limit) ||
+        !read_u32(input, &size) || size > 1048576u) return 22;
+    text = (unsigned char *)malloc(size ? size : 1u);
+    if (!text || fread(text, 1, size, input) != size) return 23;
+    memset(&result, 0xff, sizeof(result));
+    status = cupidbuild_disk_integer_parse(text, size, profile, digit_limit, &result);
+    free(text);
+    if (status != CUPIDBUILD_DISK_INTEGER_OK &&
+        (result.magnitude != 0 || result.digits != 0 ||
+         result.magnitude_fits_u32 != 0 || result.negative != 0 || result.zero != 0)) return 24;
+    if (fprintf(output, "%u %u %u %u %u %u\n", (unsigned int)status,
+               result.magnitude, result.digits, result.magnitude_fits_u32,
+               result.negative, result.zero) < 0) return 25;
+  }
+  if (fgetc(input) != EOF || fclose(input) != 0) return 26;
+  if (fclose(output) != 0) return 31;
+  {
+    FILE *bytes = fopen(argv[3], "rb");
+    unsigned int value;
+    if (!bytes || feof(bytes) || ferror(bytes)) return 32;
+    for (value = 0; value < 256u; value++) {
+      if (fgetc(bytes) != (int)value || feof(bytes) || ferror(bytes)) return 33;
+    }
+    if (fgetc(bytes) != EOF || !feof(bytes) || ferror(bytes)) return 34;
+    if (fgetc(bytes) != EOF || !feof(bytes) || ferror(bytes)) return 35;
+    clearerr(bytes);
+    if (feof(bytes) || ferror(bytes)) return 36;
+    if (fgetc(bytes) != EOF || !feof(bytes) || ferror(bytes)) return 37;
+    if (fseek(bytes, 0, SEEK_SET) != 0 || feof(bytes) || ferror(bytes)) return 38;
+    if (fgetc(bytes) != 0 || fgetc(bytes) != 1 || ftell(bytes) != 2) return 39;
+    if (fclose(bytes) != 0) return 40;
+  }
+  {
+    cupidbuild_disk_integer_t result;
+    memset(&result, 0xff, sizeof(result));
+    if (cupidbuild_disk_integer_parse((const unsigned char *)0, 1, 15, 0, &result) !=
+          CUPIDBUILD_DISK_INTEGER_ARGUMENT || result.magnitude != 0 || result.digits != 0 ||
+          result.magnitude_fits_u32 != 0 || result.negative != 0 || result.zero != 0) return 27;
+    if (cupidbuild_disk_integer_parse((const unsigned char *)"1", 1, 15, 0,
+          (cupidbuild_disk_integer_t *)0) != CUPIDBUILD_DISK_INTEGER_ARGUMENT) return 28;
+    if (cupidbuild_disk_integer_parse((const unsigned char *)"42", 2, 15, 0, &result) !=
+          CUPIDBUILD_DISK_INTEGER_OK || result.magnitude != 42 || result.digits != 2 ||
+          result.magnitude_fits_u32 != 1 || result.negative != 0 || result.zero != 0) return 29;
+  }
+  return 0;
+}
