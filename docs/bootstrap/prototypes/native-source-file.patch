@@ -0,0 +1,100 @@
+#include "cupidbuild_source_file.h"
+#include "cupidbuild_source_path.h"
+#include <stdlib.h>
+#include <string.h>
+
+#define CUPIDBUILD_SOURCE_FILE_PATH_BYTES 8192u
+
+struct cupidbuild_source_file {
+  cupidbuild_host_observer_t *observer;
+  const char *physical_root;
+  char *requested;
+  char *physical;
+  const char *logical;
+};
+
+static int source_file_separator(char value, unsigned int format) {
+  return value == '/' || (format == 2u && value == '\\');
+}
+
+int cupidbuild_source_file_open_quota(const char *working_root,
+    const char *request, size_t entry_quota, cupidbuild_source_file_t **owner_out) {
+  char absolute[CUPIDBUILD_SOURCE_FILE_PATH_BYTES];
+  char parent[CUPIDBUILD_SOURCE_FILE_PATH_BYTES];
+  cupidbuild_source_file_t *owner;
+  cupidbuild_host_entry_kind_t kind = CUPIDBUILD_ENTRY_NONE;
+  unsigned int format = cupidbuild_host_execution_format();
+  size_t length, split, parent_length, root_length, leaf_length, joined_length;
+  int separator, valid;
+  if (owner_out) *owner_out = (cupidbuild_source_file_t *)0;
+  if (!owner_out || entry_quota == 0u || entry_quota == (size_t)-1 ||
+      !cupidbuild_source_path_absolute(working_root, request, absolute, sizeof(absolute))) return 0;
+  length = strlen(absolute);
+  split = length;
+  while (split && !source_file_separator(absolute[split - 1u], format)) split--;
+  if (!split || split == length) return 0;
+  parent_length = split - 1u;
+  if (!parent_length) parent_length = 1u;
+  if (format == 2u && parent_length == 2u && absolute[1] == ':') parent_length = 3u;
+  (void)memcpy(parent, absolute, parent_length);
+  parent[parent_length] = 0;
+  owner = (cupidbuild_source_file_t *)calloc(1u, sizeof(*owner));
+  if (!owner) return 0;
+  owner->requested = (char *)malloc(length + 1u);
+  if (!owner->requested) {
+    (void)cupidbuild_source_file_close(owner);
+    return 0;
+  }
+  (void)memcpy(owner->requested, absolute, length + 1u);
+  owner->logical = owner->requested + split;
+  valid = cupidbuild_host_observer_resolve_source_root_quota(parent, entry_quota,
+      &owner->observer, &owner->physical_root) &&
+      cupidbuild_host_observer_path_kind(owner->observer, owner->logical, &kind) &&
+      kind == CUPIDBUILD_ENTRY_FILE;
+  if (valid) {
+    root_length = strlen(owner->physical_root);
+    leaf_length = strlen(owner->logical);
+    separator = root_length && !source_file_separator(owner->physical_root[root_length - 1u], format);
+    joined_length = root_length + (separator ? 1u : 0u) + leaf_length;
+    valid = joined_length < CUPIDBUILD_SOURCE_FILE_PATH_BYTES;
+    if (valid) {
+      owner->physical = (char *)malloc(joined_length + 1u);
+      valid = owner->physical != (char *)0;
+      if (valid) {
+        (void)memcpy(owner->physical, owner->physical_root, root_length);
+        if (separator) owner->physical[root_length++] = '/';
+        (void)memcpy(owner->physical + root_length, owner->logical, leaf_length + 1u);
+        valid = cupidbuild_host_observer_require_unchanged(owner->observer);
+      }
+    }
+  }
+  if (!valid) {
+    (void)cupidbuild_source_file_close(owner);
+    return 0;
+  }
+  *owner_out = owner;
+  return 1;
+}
+
+int cupidbuild_source_file_view(cupidbuild_source_file_t *owner,
+                               cupidbuild_source_file_view_t *view_out) {
+  if (view_out) (void)memset(view_out, 0, sizeof(*view_out));
+  if (!owner || !view_out || !owner->observer ||
+      !cupidbuild_host_observer_require_unchanged(owner->observer)) return 0;
+  view_out->observer = owner->observer;
+  view_out->physical_root = owner->physical_root;
+  view_out->logical = owner->logical;
+  view_out->requested_absolute = owner->requested;
+  view_out->physical_absolute = owner->physical;
+  return 1;
+}
+
+int cupidbuild_source_file_close(cupidbuild_source_file_t *owner) {
+  int valid;
+  if (!owner) return 1;
+  valid = cupidbuild_host_observer_close(owner->observer);
+  free(owner->requested);
+  free(owner->physical);
+  free(owner);
+  return valid;
+}
