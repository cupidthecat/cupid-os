+++ b/toolchain/prototypes/native_source_file/source_file_contract.cc
@@ -0,0 +1,98 @@
+#include "cupidbuild_source_file.h"
+#include <stdio.h>
+#include <string.h>
+
+static int nibble(char value) {
+  if (value >= '0' && value <= '9') return value - '0';
+  if (value >= 'a' && value <= 'f') return value - 'a' + 10;
+  return -1;
+}
+
+static int decode(const char *text, char *result, size_t capacity) {
+  size_t used = 0u;
+  while (*text) {
+    int high = nibble(*text++), low;
+    if (!*text || high < 0) return 0;
+    low = nibble(*text++);
+    if (low < 0 || used + 1u >= capacity || (high == 0 && low == 0)) return 0;
+    result[used++] = (char)((high << 4) | low);
+  }
+  result[used] = 0;
+  return 1;
+}
+
+int main(int argc, char **argv) {
+  char root[32768], request[32768], physical[8192], requested[8192];
+  cupidbuild_source_file_t *owner = (cupidbuild_source_file_t *)1;
+  cupidbuild_source_file_view_t view;
+  cupidbuild_host_transaction_t *transaction = (cupidbuild_host_transaction_t *)0;
+  cupidbuild_host_stream_observation_t stream;
+  const char *mode;
+  size_t quota = 256u;
+  int valid, accepted = 1, closed = 1;
+  if (argc != 6 || !decode(argv[2], root, sizeof(root)) ||
+      !decode(argv[3], request, sizeof(request)) || !decode(argv[4], physical, sizeof(physical)) ||
+      !decode(argv[5], requested, sizeof(requested))) return 80;
+  mode = argv[1];
+  if (strcmp(mode, "zero-quota") == 0) quota = 0u;
+  if (strcmp(mode, "max-quota") == 0) quota = (size_t)-1;
+  if (strcmp(mode, "one-quota") == 0) quota = 1u;
+  if (strcmp(mode, "two-quota") == 0) quota = 2u;
+  valid = cupidbuild_source_file_open_quota(strcmp(mode, "null-root") == 0 ? (const char *)0 : root,
+      strcmp(mode, "null-request") == 0 ? (const char *)0 : request, quota,
+      strcmp(mode, "null-output") == 0 ? (cupidbuild_source_file_t **)0 : &owner);
+  if (!valid) {
+    if (strcmp(mode, "null-output") != 0 && owner) return 81;
+    (void)fputs("reject", stdout);
+    return 2;
+  }
+  (void)memset(root, 'x', strlen(root));
+  (void)memset(request, 'x', strlen(request));
+  if (!cupidbuild_source_file_view(owner, &view) || !view.observer || !view.physical_root ||
+      !view.logical || strcmp(view.physical_absolute, physical) != 0 ||
+      strcmp(view.requested_absolute, requested) != 0) goto mismatch;
+  if (strcmp(mode, "null-view") == 0) {
+    if (cupidbuild_source_file_view(owner, (cupidbuild_source_file_view_t *)0) ||
+        !cupidbuild_source_file_view(owner, &view)) goto mismatch;
+  }
+  if (strcmp(mode, "null-owner-view") == 0) {
+    (void)memset(&view, 1, sizeof(view));
+    if (cupidbuild_source_file_view((cupidbuild_source_file_t *)0, &view) ||
+        view.observer || view.physical_root || view.logical || view.requested_absolute || view.physical_absolute ||
+        !cupidbuild_source_file_view(owner, &view)) goto mismatch;
+  }
+  if (strcmp(mode, "metadata") != 0 && strcmp(mode, "hold-metadata") != 0 &&
+      !cupidbuild_host_observer_file_stream_retained(view.observer, view.logical, 1048576u,
+          (cupidbuild_host_stream_sink_t)0, (void *)0, &stream)) goto mismatch;
+  if (strcmp(mode, "hold-borrow") == 0) {
+    if (!cupidbuild_host_transaction_open(view.physical_root, view.logical, "owned-output.img", &transaction) ||
+        !cupidbuild_host_transaction_borrow_observer(transaction, view.observer) ||
+        !cupidbuild_host_require_publication_boundary(transaction)) goto mismatch;
+  }
+  if (strcmp(mode, "hold-metadata") == 0 || strcmp(mode, "hold-stream") == 0 ||
+      strcmp(mode, "hold-borrow") == 0) {
+    (void)fputs("ready", stdout);
+    (void)fflush(stdout);
+    {
+      unsigned char signal;
+      if (fread(&signal, 1u, 1u, stdin) != 1u) goto mismatch;
+    }
+    accepted = transaction ? cupidbuild_host_require_publication_boundary(transaction)
+                           : cupidbuild_source_file_view(owner, &view);
+    if (!accepted) {
+      (void)memset(&view, 1, sizeof(view));
+      if (cupidbuild_source_file_view(owner, &view) || view.observer || view.physical_root ||
+          view.logical || view.requested_absolute || view.physical_absolute) goto mismatch;
+      if (transaction && cupidbuild_host_require_publication_boundary(transaction)) goto mismatch;
+    }
+  }
+  if (!cupidbuild_host_transaction_close(transaction)) closed = 0;
+  if (!cupidbuild_source_file_close(owner)) closed = 0;
+  if (!closed) return 82;
+  (void)fputs(accepted ? "accept" : "reject", stdout);
+  return accepted ? 0 : 2;
+mismatch:
+  (void)cupidbuild_host_transaction_close(transaction);
+  (void)cupidbuild_source_file_close(owner);
+  return 83;
+}
