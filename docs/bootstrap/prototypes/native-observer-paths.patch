+      REQUIRE(!cupidbuild_host_observer_require_unchanged(observer));
+    } else if (strcmp(mode, "wait-absence") == 0) {
+      REQUIRE(cupidbuild_host_observer_path_kind(observer, second, &kind) && kind == CUPIDBUILD_ENTRY_NONE);
+      REQUIRE(pause());
+      REQUIRE(!cupidbuild_host_observer_require_unchanged(observer));
+      kind = CUPIDBUILD_ENTRY_FILE;
+      REQUIRE(!cupidbuild_host_observer_path_kind(observer, second, &kind) && kind == CUPIDBUILD_ENTRY_NONE);
+    } else if (strcmp(mode, "wait-disappeared") == 0) {
+      REQUIRE(cupidbuild_host_observer_path_kind(observer, second, &kind) && kind == CUPIDBUILD_ENTRY_FILE);
+      REQUIRE(pause());
+      REQUIRE(!cupidbuild_host_observer_path_kind(observer, second, &kind) && kind == CUPIDBUILD_ENTRY_NONE);
+      REQUIRE(!cupidbuild_host_observer_require_unchanged(observer));
+    } else if (strcmp(mode, "missing-file-comparison") == 0) {
+      int same = 99;
+      REQUIRE(cupidbuild_host_observer_path_kind(observer, second, &kind) && kind == CUPIDBUILD_ENTRY_NONE);
+      REQUIRE(!cupidbuild_host_observer_files_captured_same(observer, second, observer, second, &same) && !same);
+      REQUIRE(!cupidbuild_host_observer_require_unchanged(observer));
+    } else if (strcmp(mode, "root-alias") == 0) {
+      int same = 99;
+      REQUIRE(cupidbuild_host_observer_open_quota(second, 65536u, &other));
+      REQUIRE(cupidbuild_host_observer_roots_same(observer, other, &same) && same);
+      REQUIRE(cupidbuild_host_observer_kind(observer, "payload.bin", &kind) && kind == CUPIDBUILD_ENTRY_FILE);
+      REQUIRE(cupidbuild_host_observer_kind(other, "payload.bin", &kind) && kind == CUPIDBUILD_ENTRY_FILE);
+      REQUIRE(cupidbuild_host_observer_files_same(observer, "payload.bin", other, "payload.bin", &same) && same);
+    } else if (strcmp(mode, "capture") == 0) {
+      cupidbuild_host_stream_observation_t result;
+      unsigned int index;
+      REQUIRE(cupidbuild_host_observer_path_kind(observer, second, &kind) && kind == CUPIDBUILD_ENTRY_FILE);
+      REQUIRE(cupidbuild_host_observer_file_stream_retained(observer, second, 1048576u,
+          (cupidbuild_host_stream_sink_t)0, (void *)0, &result));
+      REQUIRE(cupidbuild_host_observer_require_unchanged(observer));
+      printf("capture %u ", (unsigned int)result.size);
+      for (index = 0u; index < 32u; index++) printf("%02x", result.sha256[index]);
+      putchar('\n');
+    } else return 3;
+  }
+  REQUIRE(cupidbuild_host_observer_close(observer));
+  REQUIRE(cupidbuild_host_observer_close(other));
+  puts("ok");
+  return 0;
+}
--- /dev/null
+++ b/toolchain/prototypes/native_observer_paths/unc_resolved_parent_contract.cc
@@ -0,0 +1,53 @@
+#include "cupidbuild_host.h"
+#include <stdio.h>
+#include <string.h>
+
+#define REQUIRE(value) do { if (!(value)) { fprintf(stderr, "check failed at %d\n", __LINE__); return 1; } } while (0)
+
+static int unhex(const char *input, char *output, size_t capacity) {
+  size_t count = 0u;
+  while (*input) {
+    unsigned int value = 0u, index;
+    for (index = 0u; index < 2u; index++) {
+      unsigned char digit = (unsigned char)*input++;
+      if (digit >= '0' && digit <= '9') value = value * 16u + digit - '0';
+      else if (digit >= 'a' && digit <= 'f') value = value * 16u + digit - 'a' + 10u;
+      else return 0;
+    }
+    if (!value || count + 1u >= capacity) return 0;
+    output[count++] = (char)value;
+  }
+  output[count] = 0;
+  return 1;
+}
+
+int main(int argc, char **argv) {
+  char root[8192];
+  const char *resolved, *output;
+  cupidbuild_host_output_parent_t *parent = (cupidbuild_host_output_parent_t *)0;
+  if (argc != 3 || !unhex(argv[1], root, sizeof(root))) return 2;
+  if (strcmp(argv[2], "reject") == 0) {
+    REQUIRE(!cupidbuild_host_output_parent_resolve_existing(root,
+        "payload.bin", "created.bin", &parent));
+    REQUIRE(cupidbuild_host_output_parent_resolved_root(parent) == (const char *)0);
+    REQUIRE(!cupidbuild_host_output_parent_require_current(parent));
+  } else {
+    REQUIRE(strcmp(argv[2], "resolve") == 0);
+    REQUIRE(cupidbuild_host_output_parent_resolve_existing(root,
+        "payload.bin", "created.bin", &parent));
+    resolved = cupidbuild_host_output_parent_resolved_root(parent);
+    REQUIRE(resolved != (const char *)0);
+    if (cupidbuild_host_execution_format() == 2u) {
+      REQUIRE(resolved[0] == '/' && resolved[1] == '/');
+      REQUIRE(strchr(resolved, '\\') == (char *)0);
+    } else REQUIRE(resolved[0] == '/');
+    REQUIRE(strcmp(cupidbuild_host_output_parent_resolved_source(parent), "payload.bin") == 0);
+    output = cupidbuild_host_output_parent_resolved_output(parent);
+    REQUIRE(output != (const char *)0);
+    REQUIRE(strcmp(output, "created.bin") == 0);
+    REQUIRE(cupidbuild_host_output_parent_require_current(parent));
+  }
+  REQUIRE(cupidbuild_host_output_parent_close(parent));
+  puts("ok");
+  return 0;
+}
