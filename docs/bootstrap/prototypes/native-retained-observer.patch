+      REQUIRE(cupidbuild_host_observer_file_stream_retained(left, second, 65536u,
+          (cupidbuild_host_stream_sink_t)0, (void *)0, &first));
+      REQUIRE(pause());
+      memset(&result, 0xff, sizeof(result));
+      if (strcmp(mode, "wait-parent-custody") == 0) {
+        REQUIRE(cupidbuild_host_observer_file_stream_retained(left, second, 65536u,
+            (cupidbuild_host_stream_sink_t)0, (void *)0, &result));
+        REQUIRE(result.size == first.size && memcmp(result.sha256, first.sha256, 32u) == 0);
+        REQUIRE(cupidbuild_host_observer_require_unchanged(left));
+      } else {
+        REQUIRE(!cupidbuild_host_observer_file_stream_retained(left, second, 65536u,
+            (cupidbuild_host_stream_sink_t)0, (void *)0, &result));
+        REQUIRE(cleared(result) && !cupidbuild_host_observer_require_unchanged(left));
+        REQUIRE(!cupidbuild_host_observer_roots_captured_same(left, left, &same) && !same);
+      }
+    } else return 3;
+  }
+  REQUIRE(cupidbuild_host_observer_close(left));
+  REQUIRE(cupidbuild_host_observer_close(right));
+  puts("ok");
+  return 0;
+}
