+#include "cupidbuild_host.h"
+#include <stdio.h>
+#include <string.h>
+
+#define REQUIRE(value) do { if (!(value)) { fprintf(stderr, "check failed at %d\n", __LINE__); return 1; } } while (0)
+
+static int unhex(const char *input, char *output, size_t capacity) {
+  size_t count = 0u;
+  while (*input) {
+    unsigned int value = 0u, index;
+    for (index = 0u; index < 2u; index++) {
+      unsigned char digit = (unsigned char)*input++;
+      if (digit >= '0' && digit <= '9') value = value * 16u + digit - '0';
+      else if (digit >= 'a' && digit <= 'f') value = value * 16u + digit - 'a' + 10u;
+      else return 0;
+    }
+    if (!value || count + 1u >= capacity) return 0;
+    output[count++] = (char)value;
+  }
+  output[count] = 0;
+  return 1;
+}
+
+int main(int argc, char **argv) {
+  char root[8192];
+  const char *resolved, *output;
+  cupidbuild_host_output_parent_t *parent = (cupidbuild_host_output_parent_t *)0;
+  if (argc != 3 || !unhex(argv[1], root, sizeof(root))) return 2;
+  if (strcmp(argv[2], "reject") == 0) {
+    REQUIRE(!cupidbuild_host_output_parent_resolve_existing(root,
+        "payload.bin", "created.bin", &parent));
+    REQUIRE(cupidbuild_host_output_parent_resolved_root(parent) == (const char *)0);
+    REQUIRE(!cupidbuild_host_output_parent_require_current(parent));
+  } else {
+    REQUIRE(strcmp(argv[2], "resolve") == 0);
+    REQUIRE(cupidbuild_host_output_parent_resolve_existing(root,
+        "payload.bin", "created.bin", &parent));
+    resolved = cupidbuild_host_output_parent_resolved_root(parent);
+    REQUIRE(resolved != (const char *)0);
+    if (cupidbuild_host_execution_format() == 2u) {
+      REQUIRE(resolved[0] == '/' && resolved[1] == '/');
+      REQUIRE(strchr(resolved, '\\') == (char *)0);
+    } else REQUIRE(resolved[0] == '/');
+    REQUIRE(strcmp(cupidbuild_host_output_parent_resolved_source(parent), "payload.bin") == 0);
+    output = cupidbuild_host_output_parent_resolved_output(parent);
+    REQUIRE(output != (const char *)0);
+    REQUIRE(strcmp(output, "created.bin") == 0);
+    REQUIRE(cupidbuild_host_output_parent_require_current(parent));
+  }
+  REQUIRE(cupidbuild_host_output_parent_close(parent));
+  puts("ok");
+  return 0;
